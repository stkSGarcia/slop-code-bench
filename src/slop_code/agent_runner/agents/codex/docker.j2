FROM {{ base_image }}

# --- Switch to non-root -----------------------------------------------------
USER agent
WORKDIR /workspace

# Configure npm globals under user home
ENV NPM_CONFIG_PREFIX="$HOME/.npm-global"
ENV PATH="$HOME/.npm-global/bin:$PATH"
ENV XDG_CONFIG_HOME="$HOME/.config"
ENV XDG_DATA_HOME="$HOME/.local/share"

# Login shells reset PATH via /etc/profile. Restore the user npm bin directory
# so commands launched by Codex with `bash -lc` can find installed CLIs.
RUN printf '%s\n' 'export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"' >> "$HOME/.bash_profile"

# --- Install Codex dependencies --------------------------------------------
RUN npm install -g @openai/codex@{{ version }} && \
    mkdir -p "$HOME/.codex"
{% for command in workflow_install_commands %}
RUN {{ command }}
{% endfor %}

# --- Make the agent home usable by any runtime uid ---------------------------
# Containers run as the host user's uid:gid, not as `agent`, so relax modes
# on everything installed above.
RUN chmod -R a+rwX "$HOME"

# --- Default shell ----------------------------------------------------------
CMD ["codex"]
